{#
| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "cat.show"                                                      |
#}
{% extends "layouts.master" %}
{% block content %}

    {#
    ==========================================================================
      الصفحة الرئيسية مبنية برمجياً (على نمط متجر الغربي):
        ١) البنر الرئيسي (صورة للكمبيوتر + صورة للجوال)
        ٢) لكل قسم: بنر عريض ← تحته منتجات ذلك التصنيف
        ٣) بقية المكوّنات من محرر سلة (الماركات، آراء العملاء، المزايا، الأسئلة)

      الصور توضع في: src/assets/images/  ثم: pnpm run prod  ثم الرفع.
    ==========================================================================
    #}

    {# ------------------------------------------------------------------
       ١) البنر الرئيسي
          - hero-desktop.jpg  →  1920 × 800   (الكمبيوتر والتابلت)
          - hero-mobile.jpg   →  1080 × 1440  (الجوال: أقل من 768px)
          للاستبدال: ضع صورتك بنفس الاسم بلا أي تعديل على الكود.
       ------------------------------------------------------------------ #}
    <section class="ay-custom-banners ay-custom-banners--hero mb-8">
        <picture class="block w-full">
            <source media="(max-width: 767px)" srcset="{{ 'images/hero-mobile.jpg' | asset }}">
            <img src="{{ 'images/hero-desktop.jpg' | asset }}"
                 alt="{{ store.name }}"
                 width="1920" height="800"
                 fetchpriority="high"
                 class="w-full h-auto object-contain block">
        </picture>
    </section>

    {# ------------------------------------------------------------------
       ٢) أقسام المتجر: بنر عريض ثم منتجات التصنيف تحته
       ------------------------------------------------------------------
       لإضافة قسم جديد (مثلاً: السدر والحناء) انسخ سطراً وعدّل قيمه.
       لحذف قسم احذف سطره، ولتغيير الترتيب غيّر ترتيب الأسطر.

         title        عنوان القسم فوق المنتجات
         image        صورة الكمبيوتر  1920 × 500  (في src/assets/images)
         mobile       صورة الجوال (اختياري) — إن تُركت فارغة تُستخدم صورة الكمبيوتر
         url          رابط البنر و"عرض الكل" (رابط التصنيف في متجرك)
         category_id  رقم التصنيف في سلة (من رابط التصنيف: .../c123456 → 123456)
                      إن تُرك فارغاً تُعرض أحدث المنتجات مؤقتاً
       ------------------------------------------------------------------ #}
    {% set ay_sections = [
        { key: 'honey',  title: 'العسل',              image: 'banner-honey.jpg',  mobile: '', url: '#', category_id: '' },
        { key: 'oils',   title: 'الزيوت الطبيعية',    image: 'banner-oils.jpg',   mobile: '', url: '#', category_id: '' },
        { key: 'herbs',  title: 'الأعشاب',            image: 'banner-herbs.jpg',  mobile: '', url: '#', category_id: '' },
        { key: 'spices', title: 'البهارات',           image: 'banner-spices.jpg', mobile: '', url: '#', category_id: '' },
    ] %}

    {% for section in ay_sections %}
        <section class="ay-custom-section ay-custom-section--{{ section.key }} mb-8">

            {# بنر القسم #}
            <div class="ay-custom-banners ay-custom-banners--section container">
                <a href="{{ section.url }}" class="block w-full" aria-label="{{ section.title }}">
                    <picture class="block w-full">
                        {% if section.mobile %}
                            <source media="(max-width: 767px)" srcset="{{ ('images/' ~ section.mobile) | asset }}">
                        {% endif %}
                        <img src="{{ ('images/' ~ section.image) | asset }}"
                             alt="{{ section.title }}"
                             width="1920" height="500"
                             loading="lazy"
                             class="w-full h-auto object-contain block">
                    </picture>
                </a>
            </div>

            {# منتجات القسم #}
            <div class="container mt-6">
                <salla-products-slider
                    slider-id="ay-section-{{ section.key }}"
                    {% if section.category_id %}
                        source="categories"
                        source-value="[{{ section.category_id }}]"
                    {% else %}
                        source="latest"
                    {% endif %}
                    limit="10"
                    block-title="{{ section.title }}"
                    {% if section.url and section.url != '#' %}
                        display-all-url="{{ section.url }}"
                    {% endif %}
                ></salla-products-slider>
            </div>

        </section>
    {% endfor %}

    {# ------------------------------------------------------------------
       ٣) بقية الصفحة من محرر سلة: الماركات، آراء العملاء، المزايا، الأسئلة الشائعة
       ------------------------------------------------------------------ #}
    {% component home %}
{% endblock %}
{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}
