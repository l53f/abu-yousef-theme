{#
| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "cat.show"                                                      |
#}
{% extends "layouts.master" %}
{% block content %}

    {#
    ==========================================================================
      الرئيسية مبنية برمجياً بالكامل (على نمط متجر الغربي)
      لا تعتمد على محرر سلة إطلاقاً، فلا صناديق وهمية ولا فراغات.

        ١) بنر رئيسي ممتد بعرض الشاشة: صورة للكمبيوتر وأخرى للجوال
        ٢) لكل قسم: بنر ممتد ← تحته مباشرة منتجات ذلك التصنيف
        ٣) بقية المكوّنات (آراء، أسئلة، مزايا) تبقى من المحرر في آخر الصفحة

      الصور توضع في: src/assets/images/  ثم:  pnpm run prod
    ==========================================================================
    #}

    {# ------------------------------------------------------------------
       ١) البنر الرئيسي
          hero-desktop.jpg  →  1920 × 800   (من 768px فأعلى)
          hero-mobile.jpg   →  1080 × 1440  (أقل من 768px)
       ------------------------------------------------------------------ #}
    <section class="ay-custom-hero">
        <picture>
            <source media="(max-width: 767px)" srcset="{{ 'images/hero-mobile.jpg' | asset }}">
            <img src="{{ 'images/hero-desktop.jpg' | asset }}"
                 alt="{{ store.name }}"
                 width="1920" height="800"
                 fetchpriority="high">
        </picture>
    </section>

    {# ------------------------------------------------------------------
       ٢) أقسام المتجر: بنر ممتد ثم منتجات التصنيف
       ------------------------------------------------------------------
       لإضافة قسم: انسخ سطراً من القائمة وعدّل قيمه. للحذف: احذف سطره.
       للترتيب: غيّر ترتيب الأسطر.

         key          اسم داخلي (حروف إنجليزية بلا مسافات)
         title        العنوان الظاهر فوق المنتجات
         image        صورة البنر 1920 × 500 في src/assets/images
         mobile       صورة بنر الجوال (اختياري) — تُترك '' لاستخدام صورة الكمبيوتر
         url          رابط التصنيف (يُفتح عند الضغط على البنر و"عرض الكل")
         category_id  رقم التصنيف من رابطه: .../c123456 ← 123456
                      إن تُرك '' تُعرض أحدث المنتجات مؤقتاً
       ------------------------------------------------------------------ #}
    {% set ay_sections = [
        { key: 'honey',  title: 'العسل',           image: 'banner-honey.jpg',  mobile: '', url: '', category_id: '' },
        { key: 'oils',   title: 'الزيوت الطبيعية', image: 'banner-oils.jpg',   mobile: '', url: '', category_id: '' },
        { key: 'herbs',  title: 'الأعشاب',         image: 'banner-herbs.jpg',  mobile: '', url: '', category_id: '' },
        { key: 'spices', title: 'البهارات',        image: 'banner-spices.jpg', mobile: '', url: '', category_id: '' },
    ] %}

    {% for section in ay_sections %}
        <section class="ay-custom-section ay-custom-section--{{ section.key }}">

            <div class="ay-custom-banner">
                {% if section.url %}<a href="{{ section.url }}" aria-label="{{ section.title }}">{% endif %}
                    <picture>
                        {% if section.mobile %}
                            <source media="(max-width: 767px)" srcset="{{ ('images/' ~ section.mobile) | asset }}">
                        {% endif %}
                        <img src="{{ ('images/' ~ section.image) | asset }}"
                             alt="{{ section.title }}"
                             width="1920" height="500"
                             loading="lazy">
                    </picture>
                {% if section.url %}</a>{% endif %}
            </div>

            <div class="ay-custom-products container">
                <salla-products-slider
                    slider-id="ay-section-{{ section.key }}"
                    {% if section.category_id %}
                        source="categories"
                        source-value="[{{ section.category_id }}]"
                    {% else %}
                        source="latest"
                    {% endif %}
                    limit="10"
                    block-title="{{ section.title }}"
                    {% if section.url %}display-all-url="{{ section.url }}"{% endif %}
                ></salla-products-slider>
            </div>

        </section>
    {% endfor %}

    {# ------------------------------------------------------------------
       ٣) بقية الصفحة من المحرر: آراء العملاء، الأسئلة الشائعة، المزايا…
          احذف من المحرر أي "بانر عريض" أو "صور متحركة" حتى لا تتكرر.
       ------------------------------------------------------------------ #}
    {% component home %}
{% endblock %}
{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}
