{#
| القسم ٢ — التصنيفات البارزة (عناصر دائرية)                                     |
|------------------------------------|----------|--------------------------------|
| component.title                    | ?string  | عنوان القسم                    |
| component.show_cats                | bool     | عرض تصنيفات المتجر بدل الروابط |
| component.categories[]             | object[] | name / url / image / icon      |
| component.links[]                  | object[] | title / url / icon             |
| component.show_controls            | bool     | إظهار أسهم التنقل              |
| component.merge_with_top_component | bool     |                                |
| position                           | int      | ترتيب القسم يبدأ من صفر        |
#}
<section component-id="{{ componentId }}"
         data-testid="store-home-main-links"
         class="s-block s-block--categories ay-categories
                {{ component.merge_with_top_component and position ? 'merge-with-top-component' : '' }}
                {{ not component.title and component.merge_with_top_component ? 'merged-has-no-title' : '' }}">
  <div class="container">

    {% if component.title %}
      <div class="s-block__title ay-block-title">
        <div class="right-side">
          <h2>{{ component.title }}</h2>
        </div>
      </div>
    {% endif %}

    <salla-slider
      type="carousel"
      controls-outer
      show-controls="{{ component.show_controls ? 'true' : 'false' }}"
      id="main-links-{{ position }}">
      <div slot="items">

        {% if component.show_cats %}
          {% for cat in component.categories %}
            <div class="swiper-slide slide--one-sixth">
              <a href="{{ cat.url }}" class="ay-cat" aria-label="{{ cat.name }}">
                <span class="ay-cat__ring">
                  {% if cat.image %}
                    <img src="{{ cat.image }}"
                         alt="{{ cat.name }}"
                         width="128" height="128" loading="lazy" />
                  {% else %}
                    <i class="{{ cat.icon ?: 'sicon-shopping-bag' }}" aria-hidden="true"></i>
                  {% endif %}
                </span>
                <h3 class="ay-cat__name">{{ cat.name }}</h3>
              </a>
            </div>
          {% endfor %}

        {% else %}
          {% for link in component.links %}
            {% if link.title %}
              <div class="swiper-slide slide--one-sixth">
                <a href="{{ link.url }}" class="ay-cat" aria-label="{{ link.title }}">
                  <span class="ay-cat__ring">
                    <i class="{{ link.icon ?: 'sicon-shopping-bag' }}" aria-hidden="true"></i>
                  </span>
                  <h3 class="ay-cat__name">{{ link.title }}</h3>
                </a>
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}

      </div>
    </salla-slider>
  </div>
</section>
