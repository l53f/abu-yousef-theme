{#
| مميزات المتجر (Store Features) — بأسلوب الإطار المتحرك                         |
|---------------|--------|---------------------------------------------------------|
| items[]       | array  | قائمة المميزات كما يضبطها التاجر من لوحة التحكم         |
| items[].icon  | string | صنف أيقونة SallaIcons مثل `sicon-shield-check`          |
| items[].title | string | عنوان الميزة                                            |
| items[].text  | string | وصف مختصر                                               |
| position      | int    | ترتيب القسم يبدأ من صفر                                 |
#}
<section component-id="{{ componentId }}"
         data-testid="store-home-features"
         class="s-block s-block--features container ay-features ay-animate">
  <div class="ay-features__grid" data-length="{{ items|length }}">
    {% for item in items %}
      <div class="ay-feature ay-anime-item">
        {# أربعة خطوط ترسم الإطار عند المرور بالمؤشر #}
        <span class="ay-feature__line ay-feature__line--b" aria-hidden="true"></span>
        <span class="ay-feature__line ay-feature__line--l" aria-hidden="true"></span>
        <span class="ay-feature__line ay-feature__line--t" aria-hidden="true"></span>
        <span class="ay-feature__line ay-feature__line--r" aria-hidden="true"></span>

        <span class="ay-feature__icon">
          <i class="{{ item.icon ?: 'sicon-shield-check' }}" aria-hidden="true"></i>
        </span>
        <h3 class="ay-feature__title">{{ item.title }}</h3>
        <p class="ay-feature__text">{{ item.text }}</p>
      </div>
    {% endfor %}
  </div>
</section>
