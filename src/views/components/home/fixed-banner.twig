{#
| البنر العريض (Fixed Banner) — العنصر الأكثر تكراراً في بنية الغربي            |
|-----------------|---------|------------------------------------------------------|
| url             | string  | رابط البنر                                           |
| image.url       | string  | صورة سطح المكتب                                      |
| image.alt       | ?string | نص بديل                                              |
| image.small_url | ?string | صورة الجوال                                          |
| position        | int     | ترتيب القسم يبدأ من صفر                              |
#}
<section component-id="{{ componentId }}"
         data-testid="store-home-fixed-banner"
         class="s-block s-block--fixed-banner ay-banner ay-animate wide-placeholder">
  <div class="container">
    {% set alt_text = image.alt|trim ? image.alt : 'بنر' %}
    <a href="{{ url }}" class="banner banner--fixed ay-banner__link ay-anime-item" aria-label="{{ alt_text }}">
      <picture>
        {% if image.small_url %}
          <source media="(max-width: 767px)" srcset="{{ image.small_url }}" />
        {% endif %}
        <img
          width="1200"
          height="300"
          src="{{ image.url }}"
          loading="lazy"
          alt="{{ alt_text }}"
          fetchpriority="high"
        />
      </picture>
    </a>
  </div>
</section>
