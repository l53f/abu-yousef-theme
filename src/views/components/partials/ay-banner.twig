{#
  بنر عريض — يُستخدم مكرراً في الصفحة الرئيسية على نمط متجر الغربي.

  | banner.image        | ?string | صورة سطح المكتب (اتركها فارغة لخلفية لونية)      |
  | banner.image_mobile | ?string | صورة الجوال (اختيارية، تحل محل صورة الديسكتوب)  |
  | banner.alt          | ?string | نص بديل للصورة                                  |
  | banner.title        | ?string | العنوان (يُخفى عند bare)                        |
  | banner.text         | ?string | نص وصفي (يُخفى عند bare)                        |
  | banner.cta          | ?string | نص الزر (يُخفى عند bare)                        |
  | banner.url          | ?string | رابط الزر أو رابط البنر كله عند bare            |
  | index               | int     | رقم البنر (لتنويع التدرّج اللوني)               |
  | full_bleed          | ?bool   | يمتد بعرض الشاشة كاملاً بلا container ولا حواف  |
  | bare                | ?bool   | صورة فقط بلا نصوص ولا أزرار ولا تعتيم           |
#}
{% set is_bleed = full_bleed|default(false) %}
{% set is_bare  = bare|default(false) %}
{% set alt_text = banner.alt|default(banner.title)|default('بنر') %}

<section class="s-block s-block--fixed-banner ay-banner ay-animate
                {{ is_bleed ? 'ay-banner--bleed' : '' }}
                {{ is_bare  ? 'ay-banner--bare'  : '' }}">

  {% set body %}
    <div class="ay-banner__link ay-anime-item ay-banner--tone-{{ index % 3 }}"
         {% if banner.image and not is_bare %}style="background-image: url('{{ banner.image }}');"{% endif %}>

      {# عند bare نعرض الصورة كعنصر img ليعمل srcset للجوال ويبقى الارتفاع طبيعياً #}
      {% if is_bare and banner.image %}
        <picture class="ay-banner__picture">
          {% if banner.image_mobile %}
            <source media="(max-width: 767px)" srcset="{{ banner.image_mobile }}" />
          {% endif %}
          <img src="{{ banner.image }}" alt="{{ alt_text }}" fetchpriority="high" />
        </picture>
      {% endif %}

      {% if not is_bare %}
        <div class="ay-banner__overlay"></div>

        <div class="ay-banner__body">
          {% if banner.title %}
            <h2 class="ay-banner__title">{{ banner.title }}</h2>
          {% endif %}
          {% if banner.text %}
            <p class="ay-banner__text">{{ banner.text }}</p>
          {% endif %}
          {% if banner.cta %}
            <a href="{{ banner.url ?: '/products' }}" class="ay-banner__cta">
              <span>{{ banner.cta }}</span>
              <i class="sicon-arrow-left" aria-hidden="true"></i>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endset %}

  {% if is_bleed %}
    {# بلا container: يمتد بعرض الشاشة الكامل #}
    {% if is_bare and banner.url %}
      <a href="{{ banner.url }}" class="ay-banner__wrap" aria-label="{{ alt_text }}">{{ body|raw }}</a>
    {% else %}
      {{ body|raw }}
    {% endif %}
  {% else %}
    <div class="container">{{ body|raw }}</div>
  {% endif %}
</section>
