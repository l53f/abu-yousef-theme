{#
  بنر عريض — شريك اختياري. غير مستخدَم حالياً في الصفحة الرئيسية،
  لأن ترتيب الأقسام عاد ليأتي من لوحة تحكم سلة عبر {% component home %}.
  محفوظ للاستخدام اليدوي داخل أي قالب عند الحاجة.

  ملاحظة: تجنّبنا هنا الالتقاط بالكتلة (set/endset) عمداً — ليس مضموناً
  في محرك Twilight وقد يسبب انهيار الصفحة.

  | banner.image        | ?string | صورة سطح المكتب                                |
  | banner.image_mobile | ?string | صورة الجوال                                    |
  | banner.alt          | ?string | نص بديل                                        |
  | banner.title        | ?string | العنوان (يُخفى عند bare)                       |
  | banner.text         | ?string | نص وصفي (يُخفى عند bare)                       |
  | banner.cta          | ?string | نص الزر (يُخفى عند bare)                       |
  | banner.url          | ?string | الرابط                                         |
  | index               | ?int    | رقم البنر لتنويع التدرّج اللوني                |
  | full_bleed          | ?bool   | امتداد بعرض الشاشة بلا container ولا حواف      |
  | bare                | ?bool   | صورة فقط بلا نصوص                              |
#}
{% set is_bleed = full_bleed|default(false) %}
{% set is_bare  = bare|default(false) %}
{% set tone     = index|default(0) % 3 %}
{% set alt_text = banner.alt|default(banner.title)|default('بنر') %}

<section class="s-block s-block--fixed-banner ay-banner ay-animate
                {{ is_bleed ? 'ay-banner--bleed' : '' }}
                {{ is_bare  ? 'ay-banner--bare'  : '' }}">
  <div class="{{ is_bleed ? 'ay-banner__full' : 'container' }}">

    {% if is_bare %}
      <a href="{{ banner.url ?: '/products' }}"
         class="ay-banner__link ay-anime-item ay-banner--tone-{{ tone }}"
         aria-label="{{ alt_text }}">
        {% if banner.image %}
          <picture class="ay-banner__picture">
            {% if banner.image_mobile %}
              <source media="(max-width: 767px)" srcset="{{ banner.image_mobile }}" />
            {% endif %}
            <img src="{{ banner.image }}" alt="{{ alt_text }}" fetchpriority="high" />
          </picture>
        {% endif %}
      </a>

    {% else %}
      <div class="ay-banner__link ay-anime-item ay-banner--tone-{{ tone }}"
           {% if banner.image %}style="background-image: url('{{ banner.image }}');"{% endif %}>
        <div class="ay-banner__overlay"></div>
        <div class="ay-banner__body">
          {% if banner.title %}<h2 class="ay-banner__title">{{ banner.title }}</h2>{% endif %}
          {% if banner.text %}<p class="ay-banner__text">{{ banner.text }}</p>{% endif %}
          {% if banner.cta %}
            <a href="{{ banner.url ?: '/products' }}" class="ay-banner__cta">
              <span>{{ banner.cta }}</span>
              <i class="sicon-arrow-left" aria-hidden="true"></i>
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}

  </div>
</section>
